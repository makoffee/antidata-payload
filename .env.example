# Database connection string. Local dev uses the Neon `dev` branch, never production.
POSTGRES_URL=postgresql://127.0.0.1:5432/your-database-name
# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
# Production host fragment (e.g. ep-xxxx-xxxx). `npm run dev` and `migrate` refuse to run against it.
PRODUCTION_DB_HOST=ep-your-production-host
# Local only: serve images missing on disk from the live site (read-only, CDN-cached).
MEDIA_FALLBACK_ORIGIN=https://your-live-domain.com
# Vercel Blob token: leave UNSET locally (uploads go to disk). Set only in Vercel (Production).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE
# Resend API key for contact form emails (domain antidata.net, EU region). Without it, emails are logged to the console.# Resend API key for contact form emails (domain antidata.net, EU region). Without it, emails are logged to the console.
RESEND_API_KEY=re_YOUR_KEY_HERE
