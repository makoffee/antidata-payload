{
  "name": "antidata-net",
  "version": "1.0.0",
  "description": "antidata.net: Payload CMS website (Next.js, Neon Postgres, Vercel Blob)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:db": "node --env-file-if-exists=.env.local scripts/check-dev-db.mjs",
    "predev": "npm run check:db && find .next -mindepth 1 -maxdepth 1 ! -name cache -exec rm -rf {} + 2>/dev/null; rm -rf .next/cache/webpack .next/cache/swc 2>/dev/null; mkdir -p .next && xattr -w com.dropbox.ignored 1 .next node_modules 2>/dev/null || true",
    "dev": "cross-env WATCHPACK_POLLING=true NODE_OPTIONS=--no-deprecation next dev --webpack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && npm run build && npm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "rm -rf node_modules package-lock.json && npm install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "ci": "if [ \"$VERCEL_ENV\" != \"production\" ]; then node scripts/check-dev-db.mjs --strict; fi && payload migrate && npm run build",
    "media:verify": "npm run check:db && node --env-file=.env.local scripts/media-verify.mjs",
    "media:restore": "npm run check:db && node --env-file=.env.local scripts/media-restore.mjs",
    "sync:media": "npm run check:db && node --env-file=.env.local scripts/sync-media.mjs",
    "backup": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/backup.ts",
    "typecheck": "tsc --noEmit",
    "migrate:create": "npm run check:db && cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "npm run check:db && cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "npm run check:db && cross-env NODE_OPTIONS=--no-deprecation payload migrate:status"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.94.2",
    "@payloadcms/db-vercel-postgres": "3.94.2",
    "@payloadcms/email-resend": "3.93.0",
    "@payloadcms/live-preview-react": "3.94.2",
    "@payloadcms/next": "3.94.2",
    "@payloadcms/plugin-form-builder": "3.94.2",
    "@payloadcms/plugin-nested-docs": "3.94.2",
    "@payloadcms/plugin-redirects": "3.94.2",
    "@payloadcms/plugin-search": "3.94.2",
    "@payloadcms/plugin-seo": "3.94.2",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.2",
    "lucide-react": "0.563.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "next-sitemap": "^4.2.3",
    "payload": "3.94.2",
    "prism-react-renderer": "^2.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.71.1",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "fsevents": true,
    "bufferutil": true,
    "utf-8-validate": true
  }
}
